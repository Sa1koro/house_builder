{
  "name": "house_builder",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @house-builder/web",
    "build": "npm run build -w @house-builder/web",
    "lint": "npm run lint -w @house-builder/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "ingest": "npm run start -w @house-builder/ingest"
  },
  "engines": {
    "node": ">=20"
  }
}
