{
  "name": "house-builder",
  "private": true,
  "version": "0.1.0",
  "description": "装修辅助产品种子 · 多用户 Web 产品（Next.js + Supabase + Vercel Blob）",
  "scripts": {
    "dev": "pnpm --filter @house-builder/web dev",
    "build": "pnpm --filter @house-builder/web build",
    "lint": "pnpm --filter @house-builder/web lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "seed:build": "node packages/supabase/scripts/build-seed.mjs"
  },
  "packageManager": "pnpm@10.33.3",
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@tailwindcss/oxide",
      "esbuild",
      "sharp",
      "unrs-resolver"
    ]
  }
}
