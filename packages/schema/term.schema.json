{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://house-builder.dev/schemas/term.json",
  "title": "Term",
  "type": "object",
  "required": ["slug", "title", "definition"],
  "properties": {
    "slug": { "type": "string" },
    "title": { "type": "string" },
    "definition": { "type": "string" },
    "category": { "type": "string" },
    "aliases": {
      "type": "array",
      "items": { "type": "string" }
    },
    "source": {
      "type": "string",
      "enum": ["seed", "enrich", "editor"]
    },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
  }
}
