{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://home-builder.example/schemas/proposal.schema.json",
  "title": "装修方案",
  "type": "object",
  "required": ["company", "packageName", "version", "currency", "costs", "lineItems"],
  "properties": {
    "company": { "type": "string", "minLength": 1 },
    "packageName": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "currency": { "type": "string", "const": "CNY" },
    "pricingArea": { "type": "number", "minimum": 0 },
    "costs": {
      "type": "object",
      "required": ["hardFit", "customization", "management", "projectManager", "total"],
      "properties": {
        "hardFit": { "type": "number", "minimum": 0 },
        "customization": { "type": "number", "minimum": 0 },
        "management": { "type": "number", "minimum": 0 },
        "projectManager": { "type": "number", "minimum": 0 },
        "total": { "type": "number", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "lineItems": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["space", "category", "specification", "brands"],
        "properties": {
          "space": { "type": "string" },
          "category": { "type": "string" },
          "specification": { "type": "string" },
          "brands": { "type": "array", "items": { "type": "string" } },
          "termSlugs": { "type": "array", "items": { "type": "string" } },
          "notes": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "sourceAssetUrl": { "type": "string", "format": "uri" },
    "ocrConfidence": { "type": "number", "minimum": 0, "maximum": 1 }
  },
  "additionalProperties": false
}
