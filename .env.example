# ===== Supabase（必填）=====
# Supabase 项目设置 → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# 仅服务端使用（enrich 写公共表 / ingest 写 draft），切勿暴露到前端
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ===== Vercel Blob（必填，方案原件存储）=====
# Vercel 项目 → Storage → Blob → .env.local 里的 token
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# ===== 站点 =====
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ===== 品牌/名词冷启动补全（可选，缺省时 enrich 走低置信度占位）=====
# 外部检索 provider：目前支持 tavily；留空则跳过外搜
ENRICH_SEARCH_PROVIDER=
TAVILY_API_KEY=

# OpenAI 兼容 LLM（任意兼容端点：OpenAI / DeepSeek / Moonshot / 本地 vLLM 等）
ENRICH_LLM_BASE_URL=https://api.openai.com/v1
ENRICH_LLM_API_KEY=
ENRICH_LLM_MODEL=gpt-4o-mini

# ===== 本地 OCR worker（必填才能推 draft）=====
# worker 调 POST /api/ingest/draft 时使用的共享密钥（自行生成一段随机串）
INGEST_WORKER_TOKEN=
