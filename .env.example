# Supabase browser client
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only Supabase access (enrichment and local OCR ingestion)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Vercel Blob
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxx

# Optional OpenAI-compatible enrichment provider
ENRICH_API_URL=https://api.openai.com/v1/chat/completions
ENRICH_API_KEY=your-provider-key
ENRICH_MODEL=gpt-4.1-mini

# Shared token used by a trusted local OCR worker
INGEST_API_TOKEN=replace-with-a-long-random-token
NEXT_PUBLIC_SITE_URL=http://localhost:3000
