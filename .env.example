# Supabase (https://supabase.com/dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Vercel Blob (https://vercel.com/docs/storage/vercel-blob)
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxx

# Enrich / cold-start lookup (optional — falls back to heuristic seed)
ENRICH_PROVIDER=mock
# ENRICH_API_KEY=sk-...
# ENRICH_SEARCH_URL=https://api.example.com/search

# Local OCR worker (packages/ingest)
INGEST_API_URL=http://localhost:3000
INGEST_SERVICE_KEY=your-service-role-key
