# —— App ——
NEXT_PUBLIC_APP_URL=http://localhost:3000

# —— Local OCR worker (packages/ingest) ——
INGEST_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
INGEST_SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
INGEST_WEB_CALLBACK_URL=http://localhost:3000/api/ingest/draft
